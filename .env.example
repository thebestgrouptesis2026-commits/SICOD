APP_NAME=SICOD
APP_ENV=local
APP_KEY=
# En produccion: APP_ENV=production y APP_DEBUG=false (nunca mostrar trazas).
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

# XAMPP / WAMP por defecto. En produccion usa un usuario propio con
# permisos solo sobre la base "sicod", nunca root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sicod
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# En produccion con HTTPS: true (la cookie de sesion no viaja por HTTP).
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

BCRYPT_ROUNDS=12

# IPs del proxy inverso (Nginx, Cloudflare), separadas por coma.
TRUSTED_PROXIES=

# Reglas del estudio y de seguridad
SICOD_SLA_MINUTOS=30
SICOD_FORZAR_CAMBIO_PASSWORD=true
# Contraseña de las cuentas que crea el seeder. Defínela en todo servidor
# público: la de por defecto (sicod2026) figura en el README.
# SICOD_PASSWORD_INICIAL=
SICOD_LOGIN_INTENTOS=5

VITE_APP_NAME="${APP_NAME}"

# Registro de peticiones para la extensión Inertia DevTools (solo desarrollo).
INERTIA_DEVTOOLS_ENABLED=false
